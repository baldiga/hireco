{
  "manifest_version": 3,
  "name": "Hireco",
  "version": "0.3.0",
  "description": "Syncs your LinkedIn connections to Hireco so your AI agent can find who can get you hired.",
  "permissions": ["storage", "alarms", "scripting", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://hireco-seven.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Hireco" }
}
