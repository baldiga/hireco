# Copy to .env.local for development; set the same names in Vercel for production.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment (used in emails and links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_REPO_URL=https://github.com/you/hireco

# Resend (all email goes through it; free plan = 100/day)
RESEND_API_KEY=
EMAIL_FROM="Hireco <hello@your-domain.com>"
EMAIL_FROM_LOGIN="Hireco <login@your-domain.com>"
# Optional: forward mail sent to your domain (Resend inbound webhook)
RESEND_WEBHOOK_SECRET=
FORWARD_TO=
# Optional: daily usage report
REPORT_EMAIL=

# Vercel Cron sends this as a Bearer token to /api/cron/daily
CRON_SECRET=

# Optional: your own Apify token for an early-access enrichment allowance (profiles.enrich_quota)
APIFY_TOKEN=

# Optional: Google Analytics (loads only after cookie consent)
NEXT_PUBLIC_GA_ID=
